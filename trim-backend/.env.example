# Database
MONGODB_URI=mongodb://localhost:27017/trim

# JWT
JWT_ACCESS_SECRET=      # openssl rand -hex 32  (64 ký tự hex)
JWT_REFRESH_SECRET=     # openssl rand -hex 32  (64 ký tự hex, KHÁC access)
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Server
PORT=5000
NODE_ENV=development

# USDA FoodData Central (https://fdc.nal.usda.gov/api-guide.html)
USDA_API_KEY=your_key_here